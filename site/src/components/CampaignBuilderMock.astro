// Toolbar of RichTextEditor, in order.
const tools = ['bold', 'italic', 'underline', 'strike', '|', 'h2', 'list', 'listOrdered', 'link2', '|'];

// ── The canvas ───────────────────────────────────────────────────
// Laid out as layoutFlow (web/src/components/app/flow/tree.ts) places it:
// 264x56 cards, 52px between chained steps, 92px under a split, 36px between
// columns (never narrower than the pill naming them). Waits sit beside the
// line into a step; a line's own + only shows on hover, so the mock draws the
// + at the end of each path only.
type Card = { id: string; x: number; y: number; icon: string; tone: string; kicker: string; title: string; summary: string; selected?: boolean };
type Scene = {
  w: number;
  cards: Card[];
  ends: [number, number][];
  lines: string[];
  pills: { x: number; y: number; label: string; cls: string }[];
  notes: { x: number; y: number; label: string }[];
  adds: [number, number][];
};
const TONE = {
  sky: 'bg-sky-50 text-sky-600 ring-sky-100',
  violet: 'bg-violet-50 text-violet-600 ring-violet-100',
  purple: 'bg-purple-50 text-purple-600 ring-purple-100',
  emerald: 'bg-emerald-50 text-emerald-600 ring-emerald-100',
};
const PILL = {
  yes: 'bg-emerald-50 text-emerald-700 ring-emerald-200/80',
  no: 'bg-white text-slate-500 ring-slate-200',
  case: 'bg-violet-50 text-violet-700 ring-violet-200/80',
};
const entry = (x: number): Card => ({ id: 'entry', x, y: 0, icon: 'login', tone: TONE.violet, kicker: 'Start', title: 'Contact enters the campaign', summary: 'First email right away' });
const firstEmail = (x: number, selected = false): Card => ({ id: 'first', x, y: 108, icon: 'mail', tone: TONE.sky, kicker: 'First email', title: 'First email', summary: 'Quick question, {{.FirstName}}', selected });
// A branch from (sx, sy) across the bus at busY down to (tx, ty).
const branch = (sx: number, sy: number, tx: number, ty: number) => {
  const busY = sy + 20;
  const r = Math.min(10, Math.abs(tx - sx) / 2);
  const dir = tx >= sx ? 1 : -1;
  return `M${sx},${sy} L${sx},${busY - r} Q${sx},${busY} ${sx + dir * r},${busY} L${tx - dir * r},${busY} Q${tx},${busY} ${tx},${busY + r} L${tx},${ty}`;
};

let scene: Scene;
if (demo === 'switch') {
  // Columns: 264 + 264 + 96.8 (wrong person) + 77.6 (Otherwise), 36 apart.
  const cx = 405.2;
  scene = {
    w: 810.4,
    cards: [
      entry(cx - 132),
      firstEmail(cx - 132),
      { id: 'sw', x: cx - 132, y: 216, icon: 'split', tone: TONE.purple, kicker: 'Switch', title: 'Route the reply', summary: "Read this contact's reply and company details. Decide whether…", selected: true },
      { id: 'deal', x: 0, y: 364, icon: 'handshake', tone: TONE.emerald, kicker: 'Action', title: 'Open a deal', summary: 'Create a CRM deal' },
      { id: 'later', x: 300, y: 364, icon: 'mail', tone: TONE.sky, kicker: 'Email', title: 'Check back later', summary: 'Circling back next quarter' },
    ],
    ends: [[648.4, 376]],
    lines: [
      `M${cx},56 L${cx},108`,
      `M${cx},164 L${cx},216`,
      branch(cx, 272, 132, 364),
      branch(cx, 272, 432, 364),
      branch(cx, 272, 648.4, 364),
      branch(cx, 272, 771.6, 364),
      'M132,420 L132,446',
      'M432,420 L432,446',
    ],
    pills: [
      { x: 132, y: 312, label: 'interested', cls: PILL.case },
      { x: 432, y: 312, label: 'not ready yet', cls: PILL.case },
      { x: 648.4, y: 312, label: 'wrong person', cls: PILL.case },
      { x: 771.6, y: 312, label: 'Otherwise', cls: PILL.no },
    ],
    notes: [
      { x: cx, y: 190, label: '3 days' },
      { x: 432, y: 344, label: '90 days' },
    ],
    adds: [[132, 457], [432, 457], [771.6, 375]],
  };
} else if (demo === 'agent') {
  scene = {
    w: 264,
    cards: [
      entry(0),
      firstEmail(0),
      { id: 'ai', x: 0, y: 216, icon: 'sparkles', tone: TONE.purple, kicker: 'AI step', title: 'Triage the reply', summary: 'Agent · 3 actions', selected: true },
    ],
    ends: [],
    lines: ['M132,56 L132,108', 'M132,164 L132,216', 'M132,272 L132,298'],
    pills: [],
    notes: [{ x: 132, y: 190, label: '3 days' }],
    adds: [[132, 309]],
  };
} else {
  scene = {
    w: 564,
    cards: [
      entry(150),
      firstEmail(150, demo === 'ai'),
      { id: 'followup', x: 0, y: 256, icon: 'mail', tone: TONE.sky, kicker: 'Reply in thread', title: 'Follow-up', summary: 'Quick question, {{.FirstName}}' },
      { id: 'tag', x: 0, y: 364, icon: 'tag', tone: TONE.emerald, kicker: 'Action', title: 'Add engagement label', summary: 'Add a label' },
      { id: 'alt', x: 300, y: 256, icon: 'mail', tone: TONE.sky, kicker: 'Email', title: 'Alternative', summary: 'Trying a different angle' },
    ],
    ends: [],
    lines: ['M282,56 L282,108', branch(282, 164, 132, 256), branch(282, 164, 432, 256), 'M132,312 L132,364', 'M132,420 L132,446', 'M432,312 L432,338'],
    pills: [
      { x: 132, y: 204, label: 'Opened the email within 3d · instant', cls: PILL.yes },
      { x: 432, y: 204, label: 'Otherwise', cls: PILL.no },
    ],
    notes: [{ x: 432, y: 236, label: '2 days' }],
    adds: [[132, 457], [432, 349]],
  };
}
// Opens at 100%, centred; an open panel covers the right 320px of the canvas.
const sceneLeft = `calc(${open ? '(100% - 320px) / 2' : '50%'} - ${scene.w / 2}px)`;

const selected = scene.cards.find((c) => c.selected);
const panelTitle = selected ? selected.title : 'First email';

// What the assistant writes at the caret (ai demo).
const written = [
  'Noticed Acme has been scaling fast on AWS. Teams your size are usually overpaying 30 to 40 percent on compute they spun up once and never tuned.',
  "I help engineering teams find that spend without re-architecting anything. Worth a quick 15-minute call to walk through the three line items I'd check first?",
  'Open to next Tuesday or Wednesday afternoon?',
];

// AIStepFields: the allowlist, with what this step enables.
const agentActions = [
  { id: 'add_tag', label: 'Add tag', icon: 'tag', tint: 'text-emerald-600', on: true, pool: 'Tags the agent can add' },
  { id: 'remove_tag', label: 'Remove tag', icon: 'tag', tint: 'text-amber-600', on: false },
  { id: 'label_email', label: 'Label email', icon: 'tags', tint: 'text-fuchsia-600', on: false },
  { id: 'unsubscribe', label: 'Unsubscribe', icon: 'belloff', tint: 'text-rose-600', on: true },
  { id: 'create_task', label: 'Create task', icon: 'checksquare', tint: 'text-violet-600', on: true },
  { id: 'create_deal', label: 'Create deal', icon: 'handshake', tint: 'text-emerald-600', on: false },
  { id: 'move_deal_stage', label: 'Move deal stage', icon: 'arrowsLR', tint: 'text-sky-600', on: false },
];

const rootClass = ['cb relative w-full bg-white text-slate-900 flex flex-col', open ? 'is-open' : ''].join(' ');
---
<div class={rootClass} data-demo={play ? 'cb' : undefined} data-scene={demo}>
  <!-- Campaign header (layout.tsx) -->
  <div class="px-5 pt-4 pb-3 flex items-start gap-3">
    <div class="min-w-0">
      <span class="inline-flex items-center gap-1 h-6 -ml-1.5 px-1.5 mb-1 rounded-md text-[11.5px] text-slate-500">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.arrowLeft}></svg>
        Campaigns
      </span>
      <div class="flex items-center gap-2">
        <h1 class="text-[18px] font-semibold text-slate-900 truncate">Q1 Sales Outreach</h1>
