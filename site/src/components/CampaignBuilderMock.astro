/**
 * The campaign Steps screen, mirrored from the app:
 *
 *   web/src/app/app/campaigns/[id]/layout.tsx                 header (back link, name, status, Start, actions) + tab bar
 *   web/src/components/app/campaigns/sequences/CampaignFlow.tsx the tree canvas (web/src/components/app/flow): the dot
 *                                                              grid, the Stop on reply toolbar row, the zoom controls,
 *                                                              StepCard cards with waits beside the lines into them,
 *                                                              branch pills over their columns, + buttons and End,
 *                                                              and the edit sheet a card click opens (NodeTypeSwitcher,
 *                                                              then the email editor or the ActionEditor with
 *                                                              SwitchStepFields / AIStepFields). The sheet itself stays
 *                                                              the 320px SidePanel springing in from the right over the
 *                                                              whole window.
 *   .../sequences/StepEmailArms.tsx + SequenceView.tsx + EmailContentEditor.tsx + RichTextEditor.tsx
 *   web/src/components/app/campaigns/ContentScore.tsx
 *   web/src/components/app/ai/RichTextAICaret.tsx              the caret companion and its ⌘J menu
 *
 * `demo` picks the screen:
 *   flow    the cursor clicks the first step (the edit panel appears at once,
 *           as in the app), then closes it with the panel's X
 *   ai      the first step is open and focused; the cursor clicks the sparkle
 *           on the caret line, types an instruction, and the assistant writes
 *           the email at the caret
 *   switch  a Switch step is open: AI reads each contact and picks a case,
 *           every case its own column under the step
 *   agent   an AI step is open: an instruction plus the actions the agent may
 *           take for each contact
 */
import DemoCursor from './DemoCursor.astro';

interface Props { demo?: 'flow' | 'ai' | 'switch' | 'agent' }
const { demo = 'flow' } = Astro.props;
// The panel is mounted from the start on every screen but the flow demo.
const open = demo !== 'flow';
const play = demo === 'flow' || demo === 'ai';

