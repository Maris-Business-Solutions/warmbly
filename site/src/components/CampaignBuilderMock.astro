                          <div class={`text-[11.5px] font-medium ${t.on ? 'text-purple-700' : 'text-slate-500'}`}>{t.label}</div>
                          <div class="text-[10.5px] text-slate-400">{t.detail}</div>
                        </div>
                        <span class={`relative inline-flex h-[18px] w-8 shrink-0 items-center rounded-full ${t.on ? 'bg-purple-600' : 'bg-slate-300'}`}><span class={`inline-block h-3.5 w-3.5 rounded-full bg-white shadow-sm ${t.on ? 'translate-x-[15px]' : 'translate-x-[2px]'}`}></span></span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
              <div>
                <div class="mb-1.5 flex items-center justify-between gap-2">
                  <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium">Cases</span>
                  <span class="inline-flex h-6 items-center gap-1 rounded-md border border-slate-200 bg-white px-2 text-[11.5px] font-medium text-slate-600"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.plus}></svg> Add case</span>
                </div>
                <div class="space-y-1.5">
                  {['interested', 'not ready yet', 'wrong person'].map((c) => (
                    <div class="flex items-center gap-1.5">
                      <div class="flex-1 min-w-0 h-7 px-2.5 rounded-md border border-slate-200 bg-white text-[12.5px] text-slate-900 flex items-center">{c}</div>
                      <span class="inline-flex size-6 shrink-0 items-center justify-center rounded text-slate-300"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.x}></svg></span>
                    </div>
                  ))}
                </div>
              </div>
              <div>
                <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium block mb-1.5">What AI can see</span>
                <div class="space-y-1">
                  {[
                    { label: 'Campaign history', detail: 'Which steps ran, opens, clicks, replies, and earlier outcomes' },
                    { label: 'Incoming email', detail: 'The newest email received from the contact (subject + preview)' },
                  ].map((t) => (
                    <div class="flex items-center gap-2 rounded-md px-2 py-1.5 ring-1 bg-purple-50 ring-purple-200">
                      <div class="min-w-0 flex-1">
                        <div class="text-[11.5px] font-medium text-purple-700">{t.label}</div>
                        <div class="text-[10.5px] text-slate-400">{t.detail}</div>
                      </div>
                      <span class="relative inline-flex h-[18px] w-8 shrink-0 items-center rounded-full bg-purple-600"><span class="inline-block h-3.5 w-3.5 rounded-full bg-white shadow-sm translate-x-[15px]"></span></span>
                    </div>
                  ))}
                </div>
                <p class="mt-1 text-[11px] text-slate-400">Contact fields are always included.</p>
              </div>
              <p class="rounded-md bg-slate-50 px-2.5 py-2 text-[11px] leading-relaxed text-slate-600 ring-1 ring-slate-200">Every case gets its own column under the step, and Otherwise catches contacts no case matched. Put normal action steps (label, deal, task) under a case to make things happen for the contacts routed down it.</p>
            </div>
            <div class="flex items-center justify-end pt-1">
              <span class="h-7 rounded-md bg-sky-600 px-3 text-[12px] font-medium text-white inline-flex items-center">Save action</span>
            </div>
          </div>
          )}

          <!-- AI step: ActionEditor > AIStepFields -->
          {demo === 'agent' && (
          <div class="space-y-5">
            <div>
              <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium block mb-1.5">Step name</span>
              <div class="h-7 px-2.5 rounded-md border border-slate-200 bg-white text-[12.5px] text-slate-900 flex items-center w-full max-w-[320px]">Triage the reply</div>
              <p class="mt-1.5 text-[11px] text-slate-400">Internal label only — shown on the node.</p>
            </div>
            <div class="space-y-4">
              <div>
                <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium block mb-1.5">Instruction</span>
                <div class="w-full min-h-[59px] rounded-md border border-slate-200 px-2.5 py-1.5 text-[12.5px] text-slate-700">Read the reply. If they ask about pricing, tag them 'pricing' and create a follow-up task for the account owner. If they say not now, create a task to check back next quarter. If they ask to stop, unsubscribe them.</div>
              </div>
              <div>
                <div class="mb-1.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-400">Actions the agent can take</div>
                <div class="divide-y divide-slate-100">
                  {agentActions.map((a) => (
                    <div class="py-1">
                      <div class="flex w-full items-center gap-2 rounded px-1.5 py-1.5 text-left text-[12.5px] text-slate-700">
                        <span class={`inline-flex size-4 shrink-0 items-center justify-center rounded border ${a.on ? 'border-sky-500 bg-sky-500 text-white' : 'border-slate-300 bg-white'}`}>
                          {a.on && <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.check}></svg>}
                        </span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={a.tint} set:html={ic[a.icon]}></svg>
                        <span class={a.on ? 'font-medium text-slate-800' : ''}>{a.label}</span>
                      </div>
                      {a.on && a.pool && (
                        <div class="ml-[1.35rem] mt-1 space-y-3 border-l border-slate-200 pl-3 pb-1.5">
                          <div>
                            <span class="text-[10px] uppercase tracking-[0.14em] text-slate-400 font-medium block mb-1.5">{a.pool}</span>
                            <div class="rounded-md border border-slate-200 bg-white min-h-[34px]"><div class="px-3 py-2 text-[11.5px] text-slate-400">Any — leave empty to let the agent choose</div></div>
                            <p class="mt-1.5 text-[11px] text-slate-400">Empty, so the agent may use any of your tags for each contact.</p>
                          </div>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
                <div class="mt-2 flex w-full items-center gap-2 rounded px-1.5 py-1.5 text-left text-[12px] text-slate-600">
                  <span class="inline-flex size-4 shrink-0 items-center justify-center rounded border border-slate-300 bg-white"></span>
                  Let the agent create a new tag/label when none fits
                </div>
                <p class="mt-2 text-[11px] leading-relaxed text-slate-400">The agent decides which of these to use for each contact, writes any task or deal details itself, and can chain several. It only takes the actions you enable, never sending or replying. Billed 1 credit per step it takes.</p>
              </div>
            </div>
            <div class="flex items-center justify-end pt-1">
              <span class="h-7 rounded-md bg-sky-600 px-3 text-[12px] font-medium text-white inline-flex items-center">Save action</span>
            </div>
          </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- AI controls use fixed positioning within the shell to match the dashboard portal. -->
  {demo === 'ai' && (
    <>
      <span class="cb-spark fixed z-40 inline-flex size-[22px] items-center justify-center rounded-md text-slate-300 transition-colors [&.is-hover]:bg-sky-50 [&.is-hover]:text-sky-600" style="left:0; top:0;" title="Write with AI (⌘J)" data-ai="spark">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.sparkles}></svg>
      </span>

      <div class="cb-menu fixed z-40 w-80 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-[0_12px_32px_-8px_rgba(15,23,42,0.22)]" style="left:0; top:0;" data-floating>
        <div class="cb-idle">
          <div class="flex items-center gap-1.5 px-2.5 pb-2 pt-2.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-sky-500" set:html={ic.sparkles}></svg>
            <span class="h-7 min-w-0 flex-1 inline-flex items-center text-[12.5px] text-slate-900 overflow-hidden whitespace-nowrap">
              <span class="cb-placeholder text-slate-400">Ask AI to write…</span>
              <span class="cb-instr">Ask for a 15 minute call about their AWS bill</span>
              <span class="cb-caret cb-caret-input"></span>
            </span>
            <span class="cb-submit inline-flex size-6 items-center justify-center rounded-md bg-sky-600 text-white transition-colors [&.is-hover]:bg-sky-700 shrink-0" data-ai="submit">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.arrowUp}></svg>
            </span>
          </div>
          <div class="border-t border-slate-100 py-1">
            <div class="flex h-8 w-full items-center gap-2 px-2.5 text-[12px] text-slate-700">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400" set:html={ic.penLine}></svg>
              Continue writing
              <span class="ml-auto text-[10px] text-slate-300">from 1 credit</span>
            </div>
          </div>
        </div>
        <div class="cb-busy flex items-center gap-2 px-3 py-2.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 animate-pulse text-sky-500" set:html={ic.sparkles}></svg>
          <span class="text-[12px] font-medium text-slate-600">Writing…</span>
        </div>
        <div class="cb-applied flex items-center gap-1.5 px-2.5 py-2">
          <span class="mr-auto inline-flex items-center gap-1.5 text-[12px] font-medium text-slate-900">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600" set:html={ic.check}></svg>
            Inserted
            <span class="text-[10.5px] font-normal text-slate-400">· 2 credits · 1.2k tok</span>
          </span>
          <span class="inline-flex h-6 items-center gap-1 rounded px-1.5 text-[11.5px] text-slate-600">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.undo}></svg> Undo
          </span>
          <span class="inline-flex h-6 items-center gap-1 rounded px-1.5 text-[11.5px] text-slate-600">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ic.refresh}></svg> Again
          </span>
          <span class="h-6 rounded bg-slate-900 px-2 text-[11.5px] font-medium text-white inline-flex items-center transition-colors [&.is-hover]:bg-slate-800" data-ai="done">Done</span>
        </div>
      </div>
    </>
  )}

  {play && <DemoCursor />}

  <style>
    /* Edit panel: mounted on click, unmounted on close, no transition (as in the app). */
    /* SidePanel's spring (stiffness 300, damping 32): x 100% -> 0 in about 450ms, no visible overshoot; out the same way. */
    .cb-edit { transform: translateX(100%); visibility: hidden; transition: transform .45s cubic-bezier(.22,.85,.35,1), visibility 0s .45s; }
    .cb.is-open .cb-edit { transform: none; visibility: visible; transition: transform .45s cubic-bezier(.22,.85,.35,1), visibility 0s; }
    /* The clicked node is the selected one while its editor is open. */
    .cb.is-open [data-selected] > .cb-node, .cb.is-open .is-selected > .cb-node { border-color: #38bdf8; box-shadow: 0 0 0 3px #e0f2fe; }
    /* Merge chips inside the editor body (.tpl-var in the app). */
    .cb-var {
      display: inline-flex; align-items: center; gap: 0.2rem; height: 1.25rem; padding: 0 0.375rem;
      border-radius: 0.25rem; border: 1px solid #e2e8f0; background: #f8fafc; color: #475569;
      font-size: 11px; line-height: 1; font-weight: 500; white-space: nowrap; vertical-align: baseline;
    }
    .cb-body p { margin: 0 0 0.6em; }
    .cb-body p:last-child { margin-bottom: 0; }
    /* DitherMeter: emerald fill on a slate-200 track, dithered ramp at the edge. */
    .cb-meter { background: #e2e8f0; }
    .cb-meter > span { display: block; height: 100%; position: relative; background: #10b981; }
    .cb-meter > span::after {
      content: ''; position: absolute; right: 0; top: 0; width: 6px; height: 100%;
      background: repeating-conic-gradient(#10b981 0 25%, #e2e8f0 0 50%) 0 0 / 2px 2px;
    }

    /* ── The caret assistant (ai demo) ── */
    .cb-caret { display: inline-block; width: 1px; height: 15px; background: #0f172a; vertical-align: text-bottom; animation: cb-blink 1s step-end infinite; }
    @keyframes cb-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
    /* Companion: only while the editor is focused; fades and shrinks away while the menu is open (120ms). */
    .cb-spark { transition: opacity .12s ease-out, transform .12s ease-out; }
    .cb:not(.is-open) .cb-spark { display: none; }
    .cb.is-ai .cb-spark { opacity: 0; transform: scale(.9); }
    /* Menu: 120ms fade, one of three panes at a time. */
    .cb-menu { opacity: 0; pointer-events: none; transition: opacity .12s ease-out; }
    .cb.is-ai .cb-menu { opacity: 1; }
    .cb-busy, .cb-applied { display: none; }
    .cb.is-busy .cb-idle, .cb.is-applied .cb-idle { display: none; }
    .cb.is-busy .cb-busy { display: flex; }
    .cb.is-applied .cb-applied { display: flex; }
    /* The instruction is typed in; the submit arrow is disabled until then. */
    .cb-instr { display: none; overflow: hidden; white-space: nowrap; }
    .cb-caret-input { display: none; }
    .cb.is-ai .cb-caret-input { display: inline-block; }
    .cb.is-typing .cb-placeholder { display: none; }
    .cb.is-typing .cb-instr { display: inline-block; animation: cb-type 1.5s steps(46, end) forwards; }
    @keyframes cb-type { from { max-width: 0; } to { max-width: 100%; } }
    .cb-submit { opacity: .4; }
    .cb.is-typing .cb-submit { opacity: 1; }
    /* The written copy lands at the caret all at once, as an insert does. */
    .cb-gen { display: none; }
    .cb.is-applied .cb-gen { display: block; }
    .cb.is-applied .cb-empty { display: none; }
    .cb.is-applied .cb-save { opacity: 1; }

    /* Reduced motion: hold the load-bearing state still. */
    .cb.is-static .cb-edit { transform: none; visibility: visible; transition: none; }
    .cb.is-static[data-scene="flow"] [data-node="first"] > .cb-node { border-color: #38bdf8; box-shadow: 0 0 0 3px #e0f2fe; }
    .cb.is-static .cb-gen { display: block; }
    .cb.is-static .cb-empty, .cb.is-static .cb-spark, .cb.is-static .cb-menu { display: none; }
  </style>
</div>

<script>
  import { playCursor } from '../lib/cursor';

  // RichTextAICaret's placement: the companion at the caret line's top, 28px
  // in from the editor's right edge; the menu bottom-start off the caret, 8px
  // down. Both are fixed inside the shell, so boxes are converted to shell px
  // (the shell is scaled by the frame). Once the copy has landed the caret line
  // is gone, so the last measured box holds, like the app's frozen position.
  function placeCaretUI(root: HTMLElement) {
    const spark = root.querySelector<HTMLElement>('.cb-spark');
    const menu = root.querySelector<HTMLElement>('.cb-menu');
    const line = root.querySelector<HTMLElement>('[data-caret-line]');
    const editor = root.querySelector<HTMLElement>('[data-editor]');
    if (!spark || !menu || !line || !editor) return;
    const stage = root.closest<HTMLElement>('[data-stage]') ?? root;
    const sr = stage.getBoundingClientRect();
    if (!sr.width) return;
    const k = stage.offsetWidth / sr.width;
    const lr = line.getBoundingClientRect();
    if (!lr.height) return;
    const er = editor.getBoundingClientRect();
    const top = (lr.top - sr.top) * k;
    const left = (lr.left - sr.left) * k;
    spark.style.top = `${top - 1}px`;
    spark.style.left = `${(er.right - sr.left) * k - 28}px`;
    menu.style.top = `${top + lr.height * k + 8}px`;
    // floating-ui shift({ padding: 8 }): the menu stays inside the viewport.
    menu.style.left = `${Math.max(8, Math.min(left, stage.offsetWidth - menu.offsetWidth - 8))}px`;
  }

  document.querySelectorAll<HTMLElement>('.cb').forEach((root) => {
    const draw = () => placeCaretUI(root);
    draw();
    requestAnimationFrame(draw);
    window.addEventListener('load', draw);
    if (document.fonts?.ready) document.fonts.ready.then(draw);
    new ResizeObserver(draw).observe(root);
    // The panel's contents reflow as the scene's classes change.
    new MutationObserver(draw).observe(root, { attributes: true, attributeFilter: ['class'] });
  });

  // The flow demo: click the first step, the panel mounts, close it again.
  document.querySelectorAll<HTMLElement>('[data-demo="cb"][data-scene="flow"]').forEach((root) => {
    playCursor(root, {
      loop: 11000,
      steps: [
        { at: 0, x: 22, y: 78 },
        { at: 2400, el: '[data-node="first"]', ox: 0.55, oy: 0.42 },
        { at: 2520, press: true, target: '[data-node="first"]', add: ['is-open'] },
        { at: 2520, add: ['is-selected'], on: '[data-node="first"]' },
        { at: 5800, el: '[data-cb="close"]', ox: 0.5, oy: 0.55, hover: '[data-cb="close"]' },
        { at: 5940, press: true, target: '[data-cb="close"]', remove: ['is-open'] },
        { at: 5940, remove: ['is-selected'], on: '[data-node="first"]' },
        { at: 8600, x: 22, y: 78 },
      ],
    });
  });

  // The ai demo: the sparkle on the caret line opens the menu, the
  // instruction is typed and sent, the copy lands, Done closes the menu.
  document.querySelectorAll<HTMLElement>('[data-demo="cb"][data-scene="ai"]').forEach((root) => {
    playCursor(root, {
      loop: 12500,
      steps: [
        { at: 0, x: 14, y: 70 },
        { at: 2200, el: '[data-ai="spark"]', ox: 0.5, oy: 0.55, hover: '[data-ai="spark"]' },
        { at: 2340, press: true, add: ['is-ai'] },
        { at: 2900, add: ['is-typing'] },
        { at: 5400, el: '[data-ai="submit"]', ox: 0.5, oy: 0.55, hover: '[data-ai="submit"]' },
        { at: 5540, press: true, target: '[data-ai="submit"]', add: ['is-busy'] },
        { at: 7100, add: ['is-applied'], remove: ['is-busy'] },
        { at: 9200, el: '[data-ai="done"]', ox: 0.5, oy: 0.55, hover: '[data-ai="done"]' },
        { at: 9340, press: true, target: '[data-ai="done"]', remove: ['is-ai'] },
        { at: 11400, x: 14, y: 70 },
      ],
    });
  });
</script>
