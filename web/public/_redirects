# Client-side routing on a static host. Without this, every route below the
# root 404s on a refresh or a shared link: the file genuinely does not exist,
# and only the app knows the route. nginx does the same thing with try_files.
#
# 200, not 301: the URL has to stay what the user asked for, or the router
# lands on the wrong route.
/  /index.html  200
/auth  /index.html  200
/auth/*  /index.html  200
/app  /index.html  200
/app/*  /index.html  200
/onboarding  /index.html  200
/onboarding/*  /index.html  200
/oauth  /index.html  200
/oauth/*  /index.html  200
/select-org  /index.html  200
/invite  /index.html  200
/connect  /index.html  200
/cli  /index.html  200
/cloud-oauth/done  /index.html  200
/oauth-return  /index.html  200
/slack/link  /index.html  200
/setup  /index.html  200
